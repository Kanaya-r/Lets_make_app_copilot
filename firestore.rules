rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ヘルパー関数: 認証済みかどうか
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ヘルパー関数: 自分自身のドキュメントかどうか
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ヘルパー関数: 現在のユーザーのプロファイルを取得
    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // ヘルパー関数: 対象ユーザーのプロファイルを取得
    function getTargetUserProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    // ヘルパー関数: 共有コードでアクセス可能か（自分の共有コードと一致）
    function hasAccessToShareCode(shareCode) {
      return isAuthenticated() && getUserProfile().shareCode == shareCode;
    }
    
    // ヘルパー関数: 共有データのオーナーか
    function isSharedDataOwner(shareCode) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/sharedData/$(shareCode)) &&
        get(/databases/$(database)/documents/sharedData/$(shareCode)).data.ownerUid == request.auth.uid;
    }
    
    // ヘルパー関数: 親アカウントが子アカウントを管理できるか
    function canManageChild(childUid) {
      return isAuthenticated() && 
        getUserProfile().accountType == 'parent' &&
        childUid in getUserProfile().childUids;
    }

    // ヘルパー関数: 子アカウントが自分の親プロフィールを読めるか
    function canReadOwnParent(parentUid) {
      return isAuthenticated() &&
        getUserProfile().accountType == 'child' &&
        getUserProfile().parentUid == parentUid;
    }
    
    // ヘルパー関数: 子アカウントが親のchildUidsに自分を追加しようとしているか
    function isChildAddingSelfToParent(userId) {
      let userProfile = getUserProfile();
      let targetProfile = resource.data;
      
      // 条件: 
      // 1. 自分が子アカウントである
      // 2. 対象が親アカウントである
      // 3. 自分のparentUidが対象のuidと一致
      // 4. 変更されるのはchildUidsとupdatedAtのみ
      // 5. 新しいchildUidsに自分のuidが含まれている
      // 6. 新しいchildUidsのサイズが1つ増えている
      return isAuthenticated() &&
        userProfile.accountType == 'child' &&
        targetProfile.accountType == 'parent' &&
        userProfile.parentUid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.accountType == resource.data.accountType &&
        request.resource.data.shareCode == resource.data.shareCode &&
        request.auth.uid in request.resource.data.childUids &&
        request.resource.data.childUids.size() == resource.data.childUids.size() + 1;
    }
    
    // ヘルパー関数: 共有登録が許可されているか（shareAllowedUntilが現在時刻より未来）
    function isShareRegistrationAllowed(parentProfile) {
      // ISO文字列は timestamp.value() で比較可能。
      return parentProfile.shareAllowedUntil != null &&
        parentProfile.shareAllowedUntil is string &&
        timestamp.value(parentProfile.shareAllowedUntil) > request.time;
    }
    
    // ヘルパー関数: 親アカウントが子アカウントの共有を解除しようとしているか
    function isParentRevokingChildShare(userId) {
      let userProfile = getUserProfile();
      let targetProfile = resource.data;
      
      // 条件:
      // 1. 自分が親アカウントである
      // 2. 対象が子アカウントである
      // 3. 対象が自分のchildUidsに含まれている
      // 4. 変更されるのはisShareRevokedとupdatedAtのみ
      // 5. isShareRevokedがtrueに設定されている
      return isAuthenticated() &&
        userProfile.accountType == 'parent' &&
        targetProfile.accountType == 'child' &&
        userId in userProfile.childUids &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.accountType == resource.data.accountType &&
        request.resource.data.shareCode == resource.data.shareCode &&
        request.resource.data.parentUid == resource.data.parentUid &&
        request.resource.data.isShareRevoked == true;
    }
    
    // ヘルパー関数: 親アカウントが自分のchildUidsから子を削除しようとしているか
    function isParentRemovingChild(userId) {
      return isOwner(userId) &&
        resource.data.accountType == 'parent' &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.accountType == resource.data.accountType &&
        request.resource.data.shareCode == resource.data.shareCode &&
        request.resource.data.childUids.size() < resource.data.childUids.size();
    }
    
    // ヘルパー関数: 子アカウントが親アカウントに昇格する場合（共有解除による自動昇格、または子からの自発的解除）
    function isChildPromotingToParent(userId) {
      return isOwner(userId) &&
        resource.data.accountType == 'child' &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.accountType == 'parent' &&
        request.resource.data.shareCode is string &&
        request.resource.data.childUids is list &&
        request.resource.data.childUids.size() == 0 &&
        !('isShareRevoked' in request.resource.data) &&
        !('parentUid' in request.resource.data);
    }
    
    // ヘルパー関数: 親アカウントが昇格通知フラグをクリアする場合
    function isClearingPromotionNotification(userId) {
      return isOwner(userId) &&
        resource.data.accountType == 'parent' &&
        resource.data.wasPromotedFromChild == true &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.accountType == resource.data.accountType &&
        request.resource.data.shareCode == resource.data.shareCode &&
        request.resource.data.childUids == resource.data.childUids &&
        !('wasPromotedFromChild' in request.resource.data);
    }
    
    // ヘルパー関数: 親アカウントが子アカウントに降格する場合
    function isParentDemotingToChild(userId) {
      return isOwner(userId) &&
        resource.data.accountType == 'parent' &&
        resource.data.childUids.size() == 0 &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.accountType == 'child' &&
        request.resource.data.shareCode is string &&
        request.resource.data.childUids is list &&
        request.resource.data.childUids.size() == 0 &&
        request.resource.data.parentUid is string;
    }
    
    // ヘルパー関数: 子アカウントが親のchildUidsから自分を削除しようとしているか（自発的な共有解除）
    function isChildRemovingSelfFromParent(userId) {
      let userProfile = getUserProfile();
      return isAuthenticated() &&
        userProfile.accountType == 'child' &&
        userProfile.parentUid == userId &&
        resource.data.accountType == 'parent' &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.accountType == resource.data.accountType &&
        request.resource.data.shareCode == resource.data.shareCode &&
        !(request.auth.uid in request.resource.data.childUids) &&
        request.resource.data.childUids.size() == resource.data.childUids.size() - 1;
    }
    
    // ヘルパー関数: 子アカウントが親のchildUidsに自分を追加しようとしているか（降格後の操作含む）
    function isAddingSelfToParentChildUids(userId) {
      let userProfile = getUserProfile();
      let targetProfile = resource.data;
      
      // 条件: 
      // 1. 対象が親アカウントである
      // 2. 自分のparentUidが対象のuidと一致
      // 3. 変更されるのはchildUidsとupdatedAtのみ
      // 4. 新しいchildUidsに自分のuidが含まれている
      // 5. 新しいchildUidsのサイズが1つ増えている
      return isAuthenticated() &&
        targetProfile.accountType == 'parent' &&
        userProfile.parentUid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.accountType == resource.data.accountType &&
        request.resource.data.shareCode == resource.data.shareCode &&
        request.auth.uid in request.resource.data.childUids &&
        request.resource.data.childUids.size() == resource.data.childUids.size() + 1;
    }
    
    // ========================================
    // users コレクション
    // ========================================
    match /users/{userId} {
      // 単一ドキュメント取得 (get):
      // - 自分自身のプロファイル
      // - 親が自分の子アカウントのプロファイルを読む
      // - 子が自分の親アカウントのプロファイルを読む
      allow get: if isOwner(userId) ||
        canManageChild(userId) ||
        canReadOwnParent(userId);
      
      // コレクションクエリ (list):
      // - usersコレクションの一覧取得は禁止（共有コード検索はshareInvites経由）
      allow list: if false;
      
      // 作成: 認証済みで自分のUIDと一致
      // セキュリティ: childUidsは空リストで開始、shareCodeは検証済み
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.accountType in ['parent', 'child'] &&
        request.resource.data.shareCode is string &&
        request.resource.data.childUids is list &&
        request.resource.data.childUids.size() == 0;
      
      // 更新: 
      // 1. 自分自身のプロファイルのみ（uid, email, accountType, shareCode, childUidsは変更不可）
      // 2. 子アカウントが親のchildUidsに自分を追加する場合
      // 3. 親アカウントが子アカウントの共有を解除する場合
      // 4. 親アカウントが自分のchildUidsから子を削除する場合
      // 5. 子アカウントが親アカウントに昇格する場合（共有解除による自動昇格、または自発的解除）
      // 6. 親アカウントが子アカウントに降格する場合
      // 7. 子アカウント（降格後含む）が親のchildUidsに自分を追加する場合
      // 8. 子アカウントが親のchildUidsから自分を削除する場合（自発的な共有解除）
      // 9. 親アカウントが昇格通知フラグをクリアする場合
      allow update: if (isOwner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.accountType == resource.data.accountType &&
        request.resource.data.shareCode == resource.data.shareCode &&
        request.resource.data.childUids == resource.data.childUids) ||
        isChildAddingSelfToParent(userId) ||
        isParentRevokingChildShare(userId) ||
        isParentRemovingChild(userId) ||
        isChildPromotingToParent(userId) ||
        isParentDemotingToChild(userId) ||
        isAddingSelfToParentChildUids(userId) ||
        isChildRemovingSelfFromParent(userId) ||
        isClearingPromotionNotification(userId);
      
      // 削除: 禁止（アカウント削除は別途管理）
      allow delete: if false;
    }

    // ========================================
    // shareInvites コレクション
    // ========================================
    match /shareInvites/{shareCode} {
      // 単一取得のみ許可（一覧は禁止）
      // 共有許可が有効な期間だけ取得可能
      allow get: if isAuthenticated() &&
        resource.data.shareCode == shareCode &&
        resource.data.ownerUid is string &&
        resource.data.enabledUntil is timestamp &&
        resource.data.enabledUntil > request.time;

      allow list: if false;

      // 作成はオーナー本人のみ
      allow create: if isAuthenticated() &&
        request.resource.data.shareCode == shareCode &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.enabledUntil is timestamp;

      // 更新は既存ドキュメントのオーナー本人のみ
      allow update: if isAuthenticated() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.shareCode == shareCode &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.enabledUntil is timestamp;

      // 削除はオーナー本人のみ
      allow delete: if isAuthenticated() &&
        resource.data.ownerUid == request.auth.uid;
    }
    
    // ========================================
    // sharedData コレクション
    // ========================================
    match /sharedData/{shareCode} {
      // 読み取り: 同じ共有コードを持つユーザー、またはオーナー自身
      allow read: if hasAccessToShareCode(shareCode) ||
        isSharedDataOwner(shareCode);
      
      // 作成: 認証済みで、ownerUidが自分自身
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.shareCode == shareCode &&
        request.resource.data.subscriptions is list;
      
      // 更新: 同じ共有コードを持つユーザー（親または子）
      // subscriptions配列の更新のみ許可
      allow update: if hasAccessToShareCode(shareCode) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.shareCode == resource.data.shareCode;
      
      // 削除: オーナーのみ
      allow delete: if isSharedDataOwner(shareCode);
    }
  }
}
